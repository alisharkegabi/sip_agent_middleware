<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the Outbound Calling Service, via the
  HttpPlatformHandler module (NOT ASP.NET Core Module — this is a Python
  process, not .NET). IIS proxies every request to a uvicorn process that
  HttpPlatformHandler starts, monitors, and restarts on your behalf.

  BEFORE USING THIS FILE:
    1. Install the "IIS HttpPlatformHandler" module (Microsoft download,
       separate from IIS itself): https://www.iis.net/downloads/microsoft/httpplatformhandler
    2. Edit processPath below to your venv's python.exe.
    3. Edit stdoutLogFile below to a real, writable path (create the
       directory first — HttpPlatformHandler will not create it for you).
    4. Put this file in the site's physical path (the same folder as
       main.py), alongside your .env file.
    5. See the "Publishing under IIS" section of README.md for the
       Application Pool settings this depends on (No Managed Code,
       AlwaysRunning, Idle Time-out = 0, single worker process).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform
      processPath="C:\inetpub\wwwroot\OutboundCallingService\venv\Scripts\python.exe"
      arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 1"
      startupTimeLimit="60"
      startupRetryCount="3"
      requestTimeout="00:10:00"
      stdoutLogEnabled="true"
      stdoutLogFile="C:\inetpub\wwwroot\OutboundCallingService\logs\iis_stdout.log">
      <!--
        stdoutLogEnabled/stdoutLogFile capture the RAW process stdout/stderr
        — this is separate from, and in addition to, the app's own
        RotatingFileHandler pipeline in logging_config.py. You need both:
          - service.log (LOG_DIR)  = your application's structured, rotated
            logs (call events, SIP status, turn latency, etc). This is the
            one you'll actually read day-to-day.
          - iis_stdout.log         = a safety net for anything that happens
            BEFORE configure_logging() runs (e.g. a Python import error,
            a missing dependency, uvicorn itself failing to bind) or an
            uncaught crash that never reaches your logger. Unlike
            service.log, this file does NOT auto-rotate — HttpPlatformHandler
            appends a fresh timestamped file per process (re)start.
            Consider turning stdoutLogEnabled off once the deployment is
            verified stable, and re-enabling only while debugging a fresh
            issue, so it doesn't grow unbounded.
      -->
      <environmentVariables>
        <!-- Never write to a console under IIS — there isn't one, and this
             keeps the setting explicit rather than relying on the default. -->
        <environmentVariable name="LOG_TO_CONSOLE" value="0" />
        <environmentVariable name="LOG_DIR" value="C:\inetpub\wwwroot\OutboundCallingService\logs" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Prefer real secrets via IIS environment variables or a
             restricted-ACL .env over committing them here; this file may
             be readable by anyone with access to the site's physical path. -->
      </environmentVariables>
    </httpPlatform>

    <!-- Block direct HTTP access to the .env file — see OPS-09. IIS will
         otherwise happily serve it as a static file to anyone who requests
         it by name. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>